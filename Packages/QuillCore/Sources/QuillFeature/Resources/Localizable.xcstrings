    "PHRASE_WRITE_FIRST_NOTE": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the compose button to write your first note. Everything is saved on this device and synced when you are online."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el botón de redactar para escribir tu primera nota. Todo se guarda en este dispositivo y se sincroniza cuando tengas conexión."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Peze bouton ekri a pou w ekri premye nòt ou. Tout bagay konsève sou aparèy sa a epi sinkronize lè ou gen koneksyon."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no botão de escrever para criar sua primeira nota. Tudo é salvo neste dispositivo e sincronizado quando você estiver online."
          }
        }
      }
    },
