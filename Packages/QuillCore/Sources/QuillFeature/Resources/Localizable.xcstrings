    "PHRASE_STORE_UNAVAILABLE": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill could not open its database, so notes will not be saved after you close the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill no pudo abrir su base de datos, así que las notas no se guardarán al cerrar la app."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Quill pa t kapab louvri baz done li, kidonk nòt yo p ap konsève lè w fèmen aplikasyon an."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Quill não conseguiu abrir seu banco de dados, então as notas não serão salvas ao fechar o app."
          }
        }
      }
    },
    "PHRASE_TRY_AGAIN": {
      "extractionState": "manual",
      "localizations": {
