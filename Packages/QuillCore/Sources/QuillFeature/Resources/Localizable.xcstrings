    "PHRASE_NOTE_DELETED_ELSEWHERE": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This note was deleted on another device, so your changes were not saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta nota se eliminó en otro dispositivo, así que tus cambios no se guardaron."
          }
        },
        "ht": {
          "stringUnit": {
            "state": "translated",
            "value": "Nòt sa a te efase sou yon lòt aparèy, kidonk chanjman ou yo pa t konsève."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta nota foi excluída em outro dispositivo, portanto suas alterações não foram salvas."
          }
        }
      }
    },
