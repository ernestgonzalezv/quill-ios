{
    "permissions": {
        "allow": [
            "Bash(make test)",
            "Bash(make lint)",
            "Bash(make build)",
            "Bash(make project)",
            "Bash(make verify)",
            "Bash(swift build:*)",
            "Bash(swift test:*)",
            "Bash(swiftlint lint:*)",
            "Bash(xcodegen generate)",
            "Bash(git status:*)",
            "Bash(git diff:*)",
            "Bash(git log:*)"
        ]
    },
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|Write|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-swift.sh",
                        "timeout": 15
                    }
                ]
            }
        ]
    }
}
